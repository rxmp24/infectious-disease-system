generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model PredictionHistory {
  id          String   @id @default(uuid())
  sessionUuid String
  type        String   // 'SYMPTOM' or 'BLOOD_SMEAR'
  inputs      String   // Stringified JSON or Filename
  diagnosis   String
  confidence  Float
  createdAt   DateTime @default(now())
}
